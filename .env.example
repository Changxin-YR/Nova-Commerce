# =============================================================================
# Nova Commerce V1 - environment template
# Copy to .env and fill in. NEVER commit the filled file (spec section 134).
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Nova Commerce
APP_ENV=dev                      # dev | test | staging | prod
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
API_V1_PREFIX=/api/v1
# Comma-separated. In production the frontend is same-origin behind Nginx.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Security / tokens (spec section 23)
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=REPLACE_ME_WITH_64_BYTES_OF_ENTROPY
JWT_ISSUER=nova-commerce
JWT_AUDIENCE=nova-commerce-api
ACCESS_TOKEN_TTL_SECONDS=900            # 15 min - short lived
REFRESH_TOKEN_TTL_SECONDS=1209600       # 14 days
REFRESH_COOKIE_NAME=nova_rt
REFRESH_COOKIE_SECURE=false             # MUST be true when APP_ENV=prod
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
PASSWORD_HASH_SCHEME=argon2

# ---------------------------------------------------------------------------
# MySQL (spec section 19)
# NOTE: host port 13306 - port 3306 is occupied by an unrelated native mysqld.
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=nova
MYSQL_USER=nova
# Never put a real credential in this template: a documented default is a
# published credential, and this repository's FG-24 secret scan fails the build
# when a value here is the value the live .env authenticates with. Keep these
# values self-consistent with DATABASE_URL so the template still works after the
# operator replaces them.
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
DATABASE_URL=mysql+pymysql://nova:change-me-strong-password@127.0.0.1:13306/nova?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Refuse to start on a non-MySQL URL. The mandatory concurrency gates (FG-09/11/12)
# depend on real row-level locking, so silently running on another engine is not
# an acceptable fallback.
DB_REQUIRE_MYSQL=true
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis - cache, rate limit, Celery broker/backend, LangGraph checkpointer
# (spec section 83: Redis MUST have a persistence strategy and a volume)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2
REDIS_DB_LOCK=3
REDIS_DB_CHECKPOINT=4
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_SOCKET_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=600

# ---------------------------------------------------------------------------
# Object storage (spec section 20)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:19000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRODUCT_IMAGES=nova-product-images
S3_BUCKET_KNOWLEDGE=nova-knowledge-private
S3_BUCKET_REPORTS=nova-reports
S3_BUCKET_EVIDENCE=nova-evidence
S3_SIGNED_URL_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=26214400          # 25 MiB
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Vector store / RAG (spec sections 11, 56, 57)
# Embedding dimension is NEVER hardcoded in code - it is resolved from
# provider metadata at startup and validated against the collection.
# ---------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=nova
QDRANT_TIMEOUT_SECONDS=10
RAG_MODE=light                         # light | full
RAG_TOP_K_DENSE=30
RAG_TOP_K_SPARSE=30
RAG_RRF_K=60
RAG_RRF_WEIGHT_DENSE=1.0
RAG_RRF_WEIGHT_SPARSE=1.0
RAG_CANDIDATE_LIMIT=40
RAG_RERANK_TOP_N=8
RAG_MIN_EVIDENCE_SCORE=0.30
RAG_FUSION_STRATEGY=rrf
RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_ENTITY_EXTRACTION=true
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_PARSE_MAX_PAGES=300
RAG_PARSE_MAX_BYTES=26214400
RAG_PARSE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Model provider abstraction (spec sections 9, 10)
# Business code must NEVER import a vendor SDK directly.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible      # openai_compatible | anthropic | ollama | fake
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

EMBEDDING_PROVIDER=openai_compatible # openai_compatible | bge_local | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=0                # 0 = auto-detect from provider metadata
EMBEDDING_BATCH_SIZE=64

RERANKER_PROVIDER=none               # none | bge_local | api | fake
RERANKER_MODEL=
RERANKER_BASE_URL=
RERANKER_API_KEY=

# Test-only escape hatch. Real LLM calls are never a hard PR dependency
# (spec section 111).
AI_USE_FAKE_PROVIDERS=false

# ---------------------------------------------------------------------------
# Agent runtime budgets (spec section 76)
# ---------------------------------------------------------------------------
AGENT_MAX_PLAN_STEPS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_REPLAN=2
AGENT_MAX_PARAM_REPAIR=2
AGENT_MAX_CONSECUTIVE_TOOL_FAILURES=3
AGENT_RUN_TIMEOUT_SECONDS=180
PENDING_ACTION_TTL_SECONDS=900

# LangGraph checkpointer: memory (dev) | redis (deploy)  - spec section 83
CHECKPOINTER_BACKEND=memory

# ---------------------------------------------------------------------------
# Commerce / orders (spec sections 30, 31, 48)
# ---------------------------------------------------------------------------
# Order number prefix: NV<YYYYMMDD><sequence>.
ORDER_NO_PREFIX=NV
# Unpaid orders hold their reserved stock for this long (spec section 50).
ORDER_PAYMENT_TIMEOUT_MINUTES=15
# ---------------------------------------------------------------------------
# Payment / fulfillment / after-sales (spec sections 42-46, Phase 5)
# ---------------------------------------------------------------------------
# Document prefixes. These are display/ops concerns, not business logic.
PAYMENT_NO_PREFIX=NVPAY
FULFILLMENT_NO_PREFIX=NVF
AFTER_SALE_NO_PREFIX=NVAS
REFUND_NO_PREFIX=NVR

# Channels the deployment accepts (spec section 42). A channel absent here is
# PAYMENT_CHANNEL_UNSUPPORTED (60005), not a stored attempt nothing can settle.
PAYMENT_ENABLED_CHANNELS=MOCK,ALIPAY,WECHAT

# MockPay is DEV/DEMO ONLY and is refused outright in staging/prod
# (REQ-PAY-005 / INV-008). The code default is false; this file sets it true for
# the dev profile. Setting it true with APP_ENV=staging|prod makes the
# application refuse to start, which is the intended failure mode.
PAYMENT_MOCK_ENABLED=true

# Provider callback HMAC secret (spec section 43). Callbacks carry no JWT: the
# signature IS the authentication model, so this key is load-bearing.
PAYMENT_CALLBACK_SECRET=dev-mock-callback-secret
PAYMENT_CALLBACK_MAX_SKEW_SECONDS=300
# Optional per-provider override, JSON, e.g. {"ALIPAY":"..."}. Empty = the
# shared secret above (the single-provider/mock case).
PAYMENT_PROVIDER_SECRETS={}

# ---------------------------------------------------------------------------
# PII redaction (spec section 94)
# ---------------------------------------------------------------------------
PII_MASK_PHONE=true
PII_MASK_EMAIL=true
PII_MASK_ADDRESS=true
PII_MASK_ID_CARD=true
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------------------
# Observability (optional profile - never a hard startup dependency)
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
OTEL_SERVICE_NAME=nova-commerce-api
OTEL_TRACES_SAMPLER_ARG=1.0

# ---------------------------------------------------------------------------
# Rate limiting / brute force (spec section 109)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_MCP_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# MCP resource server (spec sections 86-93, ADR-013) - read by app/mcp/config.py
# =============================================================================
# Every key in this block is read by backend/app/mcp/config.py, whose settings model
# uses env_prefix="MCP_". The MCP settings are deliberately NOT part of APP settings:
# tests/unit/core/test_settings_contract.py locks the application field set, and the
# resource server's identity belongs next to the MCP surface rather than inside the
# commerce core.
#
# VERIFIED: mcp==2.2.0, LATEST_PROTOCOL_VERSION=2026-07-28,
#           DEFAULT_NEGOTIATED_VERSION=2025-03-26  (see ADR-013)
# ---------------------------------------------------------------------------
MCP_SERVER_NAME=nova-commerce-mcp
MCP_SERVER_TITLE=Nova Commerce MCP
MCP_SERVER_VERSION=1.0.0
# Off by default: the surface does not exist until a profile turns it on.
MCP_ENABLED=false
MCP_HTTP_PATH=/mcp

# --- resource-server identity (spec section 87) ----------------------------
# MCP_RESOURCE_SERVER_URL is the RFC 8707 audience every accepted token must carry.
# AuthSettings.validate_token_resource=True makes the bearer middleware compare the
# token's resource indicator against this value, so a token minted for the REST API
# (OIDC_AUDIENCE below) cannot be replayed against the MCP surface.
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:18002/mcp
MCP_ISSUER_URL=http://127.0.0.1:18080/realms/nova

# --- token verification ----------------------------------------------------
# Exactly one verification key is required. Without any of the three the verifier
# refuses every token rather than skipping verification, which is the fail-closed
# direction: "not configured" must never mean "trusted".
#   HS256 (tests / single-tenant dev):  MCP_HMAC_SECRET
#   RS*/ES* (production):               MCP_PUBLIC_KEY_PEM  or  MCP_JWKS_URL
MCP_HMAC_SECRET=
MCP_PUBLIC_KEY_PEM=
MCP_JWKS_URL=http://127.0.0.1:18080/realms/nova/protocol/openid-connect/certs
MCP_ALGORITHM=RS256
MCP_LEEWAY_SECONDS=5

# --- authorization ---------------------------------------------------------
# Base scopes a client must hold. Per-tool scopes (catalog:read, orders:read,
# analytics:read, ...) are declared in app/mcp/policy.py; MCP_WRITE_SCOPE is required
# in addition by every tool that is not read-only, so a read-only integration cannot
# propose writes even when its RBAC grants them.
MCP_REQUIRED_SCOPES=nova.read
MCP_WRITE_SCOPE=nova.write

# --- transport security (spec section 88) ---------------------------------
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:5173
# The name is ..._BYTES because that is the field app.core.config.Settings already
# declared for it; ..._SIZE was documented here while nothing read it, which is the
# 'setting an operator can write to no effect' failure the settings-contract test
# exists to catch.
MCP_MAX_REQUEST_BODY_BYTES=1048576
MCP_REQUEST_TIMEOUT_SECONDS=30
MCP_SESSION_IDLE_TIMEOUT_SECONDS=1800
MCP_MAX_SESSIONS=200

# --- the one write path (REQ-MCP-008) -------------------------------------
# TTL of the pending_action created by nova.promotion.propose. The tool files an
# approval request and never creates a promotion.
MCP_PROPOSAL_TTL_SECONDS=900

# OAuth 2.1 Resource Server (spec section 87) - NO token passthrough.
# These are the authorization server's own coordinates, consumed by the identity
# configuration and by MCP_JWKS_URL/MCP_ISSUER_URL above.
OIDC_ISSUER_URL=http://127.0.0.1:18080/realms/nova
OIDC_JWKS_URL=http://127.0.0.1:18080/realms/nova/protocol/openid-connect/certs
OIDC_AUDIENCE=nova-commerce-api
OIDC_RESOURCE_URL=http://127.0.0.1:18002/mcp
OIDC_JWKS_CACHE_SECONDS=300

# Keycloak admin (demo only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=nova
KEYCLOAK_CLIENT_ID=nova-web
KEYCLOAK_MCP_CLIENT_ID=nova-mcp-client

# ---------------------------------------------------------------------------
# Seed (spec section 126)
# ---------------------------------------------------------------------------
SEED_MERCHANT_NAME=Nova Digital
SEED_HISTORY_DAYS=75
SEED_PRODUCT_COUNT=26
SEED_SKU_COUNT=68
SEED_DETERMINISTIC=true
SEED_RANDOM_SEED=20260922
