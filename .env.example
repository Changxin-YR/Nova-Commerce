# =============================================================================
# Nexora Commerce V1 - environment template
# Copy to .env and fill in. NEVER commit the filled file (spec section 134).
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Nexora Commerce
APP_ENV=dev                      # dev | test | staging | prod
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
API_V1_PREFIX=/api/v1
# Comma-separated. In production the frontend is same-origin behind Nginx.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Security / tokens (spec section 23)
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=REPLACE_ME_WITH_64_BYTES_OF_ENTROPY
JWT_ISSUER=nexora-commerce
JWT_AUDIENCE=nexora-commerce-api
ACCESS_TOKEN_TTL_SECONDS=900            # 15 min - short lived
REFRESH_TOKEN_TTL_SECONDS=1209600       # 14 days
REFRESH_COOKIE_NAME=nexora_rt
REFRESH_COOKIE_SECURE=false             # MUST be true when APP_ENV=prod
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
PASSWORD_HASH_SCHEME=argon2

# ---------------------------------------------------------------------------
# MySQL (spec section 19)
# NOTE: host port 13306 - port 3306 is occupied by an unrelated native mysqld.
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=nexora
MYSQL_USER=nexora
MYSQL_PASSWORD=nexora_dev_password
MYSQL_ROOT_PASSWORD=rootpw
DATABASE_URL=mysql+pymysql://nexora:nexora_dev_password@127.0.0.1:13306/nexora?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Refuse to start on a non-MySQL URL. The mandatory concurrency gates (FG-09/11/12)
# depend on real row-level locking, so silently running on another engine is not
# an acceptable fallback.
DB_REQUIRE_MYSQL=true
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis - cache, rate limit, Celery broker/backend, LangGraph checkpointer
# (spec section 83: Redis MUST have a persistence strategy and a volume)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2
REDIS_DB_LOCK=3
REDIS_DB_CHECKPOINT=4
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_SOCKET_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=600

# ---------------------------------------------------------------------------
# Object storage (spec section 20)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:19000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=nexoraadmin
S3_SECRET_KEY=nexorasecret
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRODUCT_IMAGES=nexora-product-images
S3_BUCKET_KNOWLEDGE=nexora-knowledge-private
S3_BUCKET_REPORTS=nexora-reports
S3_BUCKET_EVIDENCE=nexora-evidence
S3_SIGNED_URL_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=26214400          # 25 MiB
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Vector store / RAG (spec sections 11, 56, 57)
# Embedding dimension is NEVER hardcoded in code - it is resolved from
# provider metadata at startup and validated against the collection.
# ---------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=nexora
QDRANT_TIMEOUT_SECONDS=10
RAG_MODE=light                         # light | full
RAG_TOP_K_DENSE=30
RAG_TOP_K_SPARSE=30
RAG_RRF_K=60
RAG_RRF_WEIGHT_DENSE=1.0
RAG_RRF_WEIGHT_SPARSE=1.0
RAG_CANDIDATE_LIMIT=40
RAG_RERANK_TOP_N=8
RAG_MIN_EVIDENCE_SCORE=0.30
RAG_FUSION_STRATEGY=rrf
RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_ENTITY_EXTRACTION=true
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_PARSE_MAX_PAGES=300
RAG_PARSE_MAX_BYTES=26214400
RAG_PARSE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Model provider abstraction (spec sections 9, 10)
# Business code must NEVER import a vendor SDK directly.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible      # openai_compatible | anthropic | ollama | fake
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

EMBEDDING_PROVIDER=openai_compatible # openai_compatible | bge_local | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=0                # 0 = auto-detect from provider metadata
EMBEDDING_BATCH_SIZE=64

RERANKER_PROVIDER=none               # none | bge_local | api | fake
RERANKER_MODEL=
RERANKER_BASE_URL=
RERANKER_API_KEY=

# Test-only escape hatch. Real LLM calls are never a hard PR dependency
# (spec section 111).
AI_USE_FAKE_PROVIDERS=false

# ---------------------------------------------------------------------------
# Agent runtime budgets (spec section 76)
# ---------------------------------------------------------------------------
AGENT_MAX_PLAN_STEPS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_REPLAN=2
AGENT_MAX_PARAM_REPAIR=2
AGENT_MAX_CONSECUTIVE_TOOL_FAILURES=3
AGENT_RUN_TIMEOUT_SECONDS=180
PENDING_ACTION_TTL_SECONDS=900

# LangGraph checkpointer: memory (dev) | redis (deploy)  - spec section 83
CHECKPOINTER_BACKEND=memory

# ---------------------------------------------------------------------------
# PII redaction (spec section 94)
# ---------------------------------------------------------------------------
PII_MASK_PHONE=true
PII_MASK_EMAIL=true
PII_MASK_ADDRESS=true
PII_MASK_ID_CARD=true
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------------------
# Observability (optional profile - never a hard startup dependency)
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
OTEL_SERVICE_NAME=nexora-commerce-api
OTEL_TRACES_SAMPLER_ARG=1.0

# ---------------------------------------------------------------------------
# Rate limiting / brute force (spec section 109)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_MCP_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# MCP server (spec sections 86-93)
# =============================================================================
# VERIFIED: mcp==2.2.0, LATEST_PROTOCOL_VERSION=2026-07-28,
#           DEFAULT_NEGOTIATED_VERSION=2025-03-26  (see ADR-013)
# ---------------------------------------------------------------------------
MCP_SERVER_NAME=nexora-commerce-mcp
MCP_HTTP_PATH=/mcp
MCP_ALLOWED_ORIGINS=http://localhost:5173
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,nexora.local
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
MCP_REQUIRED_SCOPES=nexora.read
MCP_REQUEST_TIMEOUT_SECONDS=30
MCP_MAX_REQUEST_BODY_BYTES=1048576
MCP_SESSION_IDLE_TIMEOUT_SECONDS=1800
MCP_MAX_SESSIONS=200

# OAuth 2.1 Resource Server (spec section 87) - NO token passthrough.
OIDC_ISSUER_URL=http://127.0.0.1:18080/realms/nexora
OIDC_JWKS_URL=http://127.0.0.1:18080/realms/nexora/protocol/openid-connect/certs
OIDC_AUDIENCE=nexora-commerce-api
OIDC_RESOURCE_URL=http://127.0.0.1:18002/mcp
OIDC_JWKS_CACHE_SECONDS=300

# Keycloak admin (demo only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=nexora
KEYCLOAK_CLIENT_ID=nexora-web
KEYCLOAK_MCP_CLIENT_ID=nexora-mcp-client

# ---------------------------------------------------------------------------
# Seed (spec section 126)
# ---------------------------------------------------------------------------
SEED_MERCHANT_NAME=Nexora Digital
SEED_HISTORY_DAYS=75
SEED_PRODUCT_COUNT=26
SEED_SKU_COUNT=68
SEED_DETERMINISTIC=true
SEED_RANDOM_SEED=20260922
