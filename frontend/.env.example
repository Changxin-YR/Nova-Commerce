# Nexora frontend environment template.
#
# Copy to `.env.local` for machine-specific overrides. Vite only exposes variables
# prefixed with `VITE_`, and they are inlined at BUILD time — never put a secret here,
# because anything in this file ships to the browser.

# API base URL. Default in code is `/api/v1`.
# - dev:  `/api/v1` (Vite proxies /api -> http://127.0.0.1:8000, see vite.config.ts)
# - prod: `/api/v1` (Nginx serves the SPA and the API from ONE origin on :18000)
VITE_API_BASE_URL=/api/v1

# Request timeout in milliseconds. Defaults to 15000.
VITE_API_TIMEOUT=15000

# Document title. Defaults to "Nexora Commerce".
VITE_APP_TITLE=Nexora Commerce
